+// Temporary diagnostics; cap output per process to bound logging overhead.
+void ScrcpyTraceFrame(const char* stage, const VideoFrame& frame, int reason = -1) {
+#if defined(WEBRTC_ANDROID)
+  static std::atomic<unsigned> count{0};
+  if (count.fetch_add(1, std::memory_order_relaxed) >= 600) return;
+  __android_log_print(ANDROID_LOG_INFO, "scrcpy_drop",
+                     "%s pts_us=%lld rtp=%u size=%dx%d reason=%d",
+                     stage, static_cast<long long>(frame.timestamp_us()),
+                     frame.rtp_timestamp(), frame.width(), frame.height(), reason);
+#else
+  (void)stage; (void)frame; (void)reason;
+#endif
+}
+
 // Time interval for logging frame counts.
